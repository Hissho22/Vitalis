VITALIS_ENTRA_TENANT_ID=799bd0cb-438c-4214-9abe-19ea0d669df8
PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>

ORCHESTRATOR_AGENT_NAME=Agente-Orquestador
ADMISSION_AGENT_NAME=Agente-Admision
HISTORY_AGENT_NAME=Agente-Historico
INSURANCE_AGENT_NAME=Agente-Seguros
CONSULTATION_AGENT_NAME=Agente-Medico
PHARMACY_AGENT_NAME=Agente-Farmacia

AZURE_SQL_CONNECTION_STRING=Server=tcp:<servidor>.database.windows.net,1433;Database=VitalisDB;Uid=<usuario>;Pwd=<contraseña>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Generate a random secret of at least 32 characters for encrypted session cookies.
SESSION_SECRET=<generar-un-secreto-aleatorio-de-32-caracteres-o-mas>

# Required only for local Microsoft Entra sign-in.
MSAL_CLIENT_ID=<id-de-aplicacion>
MSAL_CLIENT_SECRET=<secreto-local-de-desarrollo>
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional Application Insights connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional corporate domain whose users get the Admin role without an SQL row (default: labmx.ai).
ALLOWED_ADMIN_DOMAIN=labmx.ai
